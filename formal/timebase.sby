[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
prove: depth 300
timeout 420

[engines]
bmc: smtbmc boolector
prove: smtbmc yices

[script]
read_verilog -formal -I. pe_timebase.v
read_verilog -formal timebase_props.v
prep -top timebase_props

[files]
../src/pe_timebase.v
timebase_props.v
